# ==========================
# WealthCash — Configuração
# ==========================

# Banco de Dados (PostgreSQL)
# Neon: https://neon.tech (grátis até 512MB)
# Supabase: https://supabase.com
DATABASE_URL="postgresql://user:password@host:5432/wealthcash?sslmode=require"

# NextAuth — gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=GERE_UM_SECRET_SEGURO_AQUI
AUTH_TRUST_HOST=true

# Rate Limiting — Upstash Redis (https://upstash.com — grátis até 10k/dia)
# UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_token_here

# Gemini AI (opcional)
# NEXT_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here
