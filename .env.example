# ==========================
# WealthCash — Configuração
# ==========================

# Banco de Dados (PostgreSQL)
# Neon: https://neon.tech (grátis até 512MB)
# Supabase: https://supabase.com
DATABASE_URL="postgresql://user:password@host:5432/wealthcash?sslmode=require"

# NextAuth — gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=GERE_UM_SECRET_SEGURO_AQUI
AUTH_TRUST_HOST=true

# Configurações do Firebase Admin SDK (Para Push Notifications mobile)
# Opcional na etapa inicial
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_CLIENT_EMAIL="your-client-email@gserviceaccount.com"
FIREBASE_PRIVATE_KEY="your-private-key-here"

# -----------------------------------------------------------------------------
# OPEN FINANCE (Parte A da Fase 4)
# Obtenha estas chaves no Dashboard da Pluggy.ai (Sandbox Mode para testes)
# -----------------------------------------------------------------------------
PLUGGY_CLIENT_ID="seu-pluggy-client-id"
PLUGGY_CLIENT_SECRET="seu-pluggy-client-secret"
PLUGGY_WEBHOOK_SECRET="seu-pluggy-webhook-secret-para-assinatura"

# -----------------------------------------------------------------------------
# PAGAMENTOS E ASSINATURAS (Parte B da Fase 4)
# Obtenha estas chaves no Dashboard do Mercado Pago Developers
# -----------------------------------------------------------------------------
MERCADOPAGO_ACCESS_TOKEN="TEST-00000000000-000000-xxxxxxxxxxxxx-00000000"
MERCADOPAGO_WEBHOOK_SECRET="v1-sua-chave-secreta-webhook"

# Rate Limiting — Upstash Redis (https://upstash.com — grátis até 10k/dia)
# UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_token_here

# Gemini AI (opcional — NÃO use prefixo NEXT_PUBLIC_, pois expõe a chave no frontend)
# GEMINI_API_KEY=your_gemini_api_key_here
