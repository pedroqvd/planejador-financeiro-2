generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String        @id @default(cuid())
  name                 String
  email                String        @unique
  password             String
  image                String?
  plan                 String        @default("free") // free, pro, premium
  aiInteractionsCount  Int           @default(0)
  aiLastInteractionAt  DateTime      @default(now())
  mercadoPagoId             String?       @unique
  mercadoPagoSubscriptionId String?
  fcmToken             String?
  referralCode         String        @unique @default(cuid())
  referredBy           String?
  referralsCount       Int           @default(0)
  preferredCurrency    String        @default("BRL") // Base currency for dashboard
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  mfaEnabled           Boolean       @default(false)
  mfaSecret            String?       // Encrypted TOTP secret
  transactions         Transaction[]
  budgets              Budget[]
  goals                Goal[]
  passwordResets       PasswordReset[]
  notifications        Notification[]
  investments          Investment[]
  pluggyItems          PluggyItem[]
  recurrences          Recurrence[]
  auditLogs            AuditLog[]

  @@index([email])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String   // e.g., "LOGIN_SUCCESS", "LOGIN_FAILURE", "DATA_EXPORT", "ACCOUNT_DELETE", "MFA_ENABLED", "MFA_DISABLED"
  details   String?  // JSON or string with more context
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model Transaction {
  id       String   @id @default(cuid())
  name     String
  category String
  amount   Float
  currency String   @default("BRL")
  type                String
  paymentMethod       String   @default("account") // account, credit_card
  installments        Int      @default(1)
  date                DateTime @default(now())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pluggyTransactionId String?  @unique

  @@index([userId])
  @@index([userId, type, date])
}

model Budget {
  id       String @id @default(cuid())
  category String
  limit    Float
  spent    Float  @default(0)
  currency String @default("BRL")
  month    String
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category, month])
  @@index([userId])
}

model Goal {
  id                String   @id @default(cuid())
  name              String
  icon              String   @default("Target")
  target            Float
  current           Float    @default(0)
  currency          String   @default("BRL")
  deadline          String
  monthlySuggestion Float    @default(0)
  color             String   @default("sky")
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())

  @@index([userId])
}

model PasswordReset {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([token])
  @@index([userId])
}

model Notification {
  id        String   @id @default(cuid())
  title     String
  message   String
  read      Boolean  @default(false)
  type      String   @default("info") // info, warning, success
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, read])
}

model Investment {
  id        String   @id @default(cuid())
  name      String
  type      String   // renda_fixa, acoes, cripto, fundos
  amount    Float
  yield     Float    @default(0) // rentabilidade
  date      DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, type])
}

model PluggyItem {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pluggyItemId    String   @unique // ID of the Item in Pluggy's database
  connectorId     Int      // ID of the bank/financial institution
  connectorName   String?  // Name of the bank (e.g., "Nubank", "Itaú")
  status          String   // WAITING_USER_INPUT, UPDATING, UPDATED, LOGIN_ERROR
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  error           String?  // Detailed error message if status is an error state
  lastSyncAt      DateTime? // Last time transactions where pulled

  @@index([userId])
}

model Recurrence {
  id          String   @id @default(cuid())
  name        String
  category    String   @default("Outros")
  amount      Float
  currency    String   @default("BRL")
  type        String   // 'expense' | 'income'
  frequency   String   @default("monthly") // 'monthly' | 'weekly' | 'annual'
  nextDueDate DateTime
  active      Boolean  @default(true)
  color       String   @default("violet")
  icon        String   @default("RefreshCcw")
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([userId, active])
}
