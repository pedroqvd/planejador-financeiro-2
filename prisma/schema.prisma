generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String        @id @default(cuid())
  name                 String
  email                String        @unique
  password             String
  image                String?
  plan                 String        @default("free") // free, pro, premium
  aiInteractionsCount  Int           @default(0)
  aiLastInteractionAt  DateTime      @default(now())
  mercadoPagoId             String?       @unique
  mercadoPagoSubscriptionId String?
  fcmToken             String?
  referralCode         String        @unique @default(cuid())
  referredBy           String?
  referralsCount       Int           @default(0)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  transactions         Transaction[]
  budgets              Budget[]
  goals                Goal[]
  passwordResets       PasswordReset[]
  notifications        Notification[]
  investments          Investment[]

  @@index([email])
}

model Transaction {
  id       String   @id @default(cuid())
  name     String
  category String
  amount   Float
  type     String
  date     DateTime @default(now())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, type, date])
}

model Budget {
  id       String @id @default(cuid())
  category String
  limit    Float
  spent    Float  @default(0)
  month    String
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category, month])
  @@index([userId])
}

model Goal {
  id                String   @id @default(cuid())
  name              String
  icon              String   @default("Target")
  target            Float
  current           Float    @default(0)
  deadline          String
  monthlySuggestion Float    @default(0)
  color             String   @default("sky")
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())

  @@index([userId])
}

model PasswordReset {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([token])
  @@index([userId])
}

model Notification {
  id        String   @id @default(cuid())
  title     String
  message   String
  read      Boolean  @default(false)
  type      String   @default("info") // info, warning, success
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, read])
}

model Investment {
  id        String   @id @default(cuid())
  name      String
  type      String   // renda_fixa, acoes, cripto, fundos
  amount    Float
  yield     Float    @default(0) // rentabilidade
  date      DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, type])
}
